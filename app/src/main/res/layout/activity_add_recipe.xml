<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Recipe"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Recipe Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Chicken Rice"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtRecipeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Brief description of the recipe"
            android:inputType="textCapSentences"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="16dp" />

        <!-- Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instructions"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter cooking instructions"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="5"
            android:gravity="top"
            android:layout_marginBottom="20dp" />

        <!-- Ingredients heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Ingredients"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Ingredient name -->
        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingredient name"
            android:inputType="textCapSentences"
            android:layout_marginBottom="10dp" />

        <!-- Quantity -->
        <EditText
            android:id="@+id/edtIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:layout_marginBottom="10dp" />

        <!-- Unit -->
        <EditText
            android:id="@+id/edtIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit (g, kg, ml, items...)"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Add ingredient button -->
        <Button
            android:id="@+id/btnAddRecipeIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Ingredient"
            android:layout_marginBottom="15dp" />

        <!-- Added ingredients -->
        <TextView
            android:id="@+id/txtAddedIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No ingredients added yet."
            android:textSize="15sp"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Recipe" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancelRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>