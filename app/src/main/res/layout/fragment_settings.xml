<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage your Smart Pantry preferences"
            android:textSize="15sp" />

        <!-- Notifications Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Notifications"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Expiry Warning -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchExpiryWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Expiry date warnings"
            android:textSize="16sp" />

        <!-- Low Stock Warning -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLowStockWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Low-stock warnings"
            android:textSize="16sp" />

        <!-- General Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="General"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- App Information -->
        <TextView
            android:id="@+id/txtAppInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Smart Pantry Manager\nVersion 1.0"
            android:textSize="16sp"
            android:padding="12dp" />

        <!-- About -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="About"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Smart Pantry Manager helps you manage pantry ingredients, track expiry dates and discover recipes based on ingredients available in your pantry."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>